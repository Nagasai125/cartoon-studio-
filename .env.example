# Browser-safe configuration. Never place secrets in VITE_* variables.
VITE_API_BASE_URL=http://localhost:8000

# API
CARTOON_STUDIO_ENVIRONMENT=local
CARTOON_STUDIO_CORS_ORIGINS=http://localhost:5173
CARTOON_STUDIO_DATABASE_URL=postgresql+asyncpg://cartoon:cartoon@127.0.0.1:55433/cartoon_studio
CARTOON_STUDIO_STORAGE_ENDPOINT=http://127.0.0.1:19000
CARTOON_STUDIO_STORAGE_BUCKET=cartoon-studio-local

# Local-only object storage credentials. Production uses managed identities.
MINIO_ROOT_USER=cartoon
MINIO_ROOT_PASSWORD=local-development-only
